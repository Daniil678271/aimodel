# ============================================================
#  Скопируйте этот файл в .env и заполните значения:
#      cp .env.example .env
#  Файл .env НЕЛЬЗЯ публиковать (он уже в .gitignore).
# ============================================================

# --- Обязательные ---------------------------------------------------------
# Токен бота от @BotFather (формат 123456789:AAxxxxxxxx...)
TELEGRAM_BOT_TOKEN=

# Ключ Gemini API из https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Модель ---------------------------------------------------------------
# Основная модель (поддерживает текст, изображения и PDF).
# Список доступных вашему ключу моделей: python -m scripts.list_models
GEMINI_MODEL=gemini-3.6-flash

# Резервная модель: используется, если основная перегружена, недоступна
# или исчерпан её лимит. Оставьте пустым, чтобы отключить.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Температура (необязательно). Для моделей Gemini 3 лучше НЕ задавать —
# Google рекомендует значение по умолчанию.
# GEMINI_TEMPERATURE=1.0

# Максимальная длина ответа в токенах (включая "размышления" модели)
GEMINI_MAX_OUTPUT_TOKENS=16384

# Таймаут одного запроса к Gemini, секунды
GEMINI_REQUEST_TIMEOUT=120

# Включить Google Search grounding (ответы с актуальными данными из интернета).
# Может тарифицироваться отдельно — проверьте актуальные цены Google.
GEMINI_USE_SEARCH=false

# --- История и файлы ------------------------------------------------------
# Сколько последних сообщений (вопросы + ответы) помнить на пользователя
MAX_HISTORY_MESSAGES=24

# Максимальный размер одного файла/фото в МБ (Telegram не отдаёт ботам >20 МБ)
MAX_FILE_MB=15

# --- Защита от злоупотреблений -------------------------------------------
# Запросов в минуту на одного пользователя (0 = без ограничения)
RATE_LIMIT_PER_MINUTE=10

# Запросов в сутки на одного пользователя (0 = без ограничения)
DAILY_LIMIT_PER_USER=0

# Белый список Telegram ID через запятую. Пусто = бот доступен всем.
# Свой ID можно узнать у бота @userinfobot
ALLOWED_USER_IDS=

# --- Прочее ---------------------------------------------------------------
# Путь к файлу базы данных SQLite (история диалогов и настройки)
DATABASE_PATH=data/bot.db

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
